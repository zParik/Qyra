# Repackages the release's .deb. Build and install from this folder with:
#   makepkg -si
pkgname=qyra-bin
pkgver=2.0.0
pkgrel=1
pkgdesc="Free, offline PDF app: read, sign, fill in, merge, compress and OCR PDFs"
arch=('x86_64')
url="https://github.com/zParik/Qyra"
license=('GPL-3.0-only')
depends=('webkit2gtk-4.1' 'gtk3' 'libsoup3' 'glib2' 'cairo' 'gdk-pixbuf2' 'dbus' 'hicolor-icon-theme')
provides=('qyra')
conflicts=('qyra')
options=('!strip' '!debug')
source=("https://github.com/zParik/Qyra/releases/download/v${pkgver}/Qyra_${pkgver}_amd64.deb"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/zParik/Qyra/v${pkgver}/LICENSE")
sha256sums=('4724824d1aadb909d2f931797ede83f121950de49b144497fb8d697ae0491ad8'
            '605e9047a563c5c8396ffb18232aa4304ec56586aee537c45064c6fb425e44ad')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
